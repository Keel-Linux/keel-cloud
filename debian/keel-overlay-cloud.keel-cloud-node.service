[Unit]
Description=Keel Cloud node agent: membership and WireGuard key exchange
Documentation=https://github.com/Keel-Linux/keel-cloud
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/keel/instance.yaml

# Root, because it reads the spec's secret files (root's, 0600) and
# writes the spec; it writes nothing else. It never writes WireGuard's
# configuration: keel spec apply converges the spec.
[Service]
Type=simple
ExecStart=/usr/bin/keel-cloud-node run
Restart=on-failure
RestartSec=30
StateDirectory=keel-cloud-node
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/keel -/etc/wireguard -/var/lib/keel
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
